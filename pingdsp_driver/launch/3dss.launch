<?xml version="1.0"?>
<launch>
    <!-- Arguments -->
    <arg name="config_file" default="$(find-pkg-share pingdsp_driver)/config/3dss_params.yaml" 
         description="Path to parameter YAML file"/>
    <arg name="filter_config" default="$(find-pkg-share pingdsp_driver)/config/filter_params.yaml" 
         description="Path to filter parameter YAML file"/>
    <arg name="recorder_config" default="$(find-pkg-share pingdsp_driver)/config/recorder_params.yaml" 
         description="Path to recorder parameter YAML file"/>
    <arg name="control_config" default="$(find-pkg-share pingdsp_driver)/config/control_params.yaml" 
         description="Path to control parameter YAML file"/>
    <arg name="sonar_host" default="192.168.228.50"
         description="Sonar TCP host. Use 127.0.0.1 for pcap replay (MODE=sim)."/>
    <arg name="sonar_port" default="23848"
         description="3DSS-DX data stream TCP port (23848; UM002 §12)."/>
    <arg name="enable_filter" default="true" 
         description="Enable point cloud filtering"/>
    <arg name="enable_recorder" default="false" 
         description="Enable point cloud recording"/>
    <arg name="enable_control" default="true" 
         description="Enable sonar control interface"/>
    <arg name="record_bag" default="false" 
         description="Enable ROS 2 bag recording of all topics"/>
    <arg name="publish_tf" default="true"
         description="Let the sonar driver broadcast map-&gt;odom-&gt;sonar TF. Set false when the SBG stack owns the pose tree."/>
    <arg name="publish_odometry" default="true"
         description="Let the sonar driver publish vehicle position/path. Set false when the SBG stack owns odometry."/>
    <arg name="publish_navsatfix" default="true"
         description="Republish the GPS embedded in the sonar NMEA stream as sensor_msgs/NavSatFix (sonar/fix). Set false when the SBG stack owns the geo fix."/>
    <arg name="use_sonar_time" default="true"
         description="Stamp pings with the sonar's GNSS-disciplined acquisition time (keeps data aligned to the real-time SBG pose under stream latency). Falls back to arrival time if the sonar clock looks unsynced."/>
    
    <!-- 3DSS-DX Driver Node -->
    <node pkg="pingdsp_driver" exec="tdss_driver" name="tdss_driver" output="screen">
        <param from="$(var config_file)"/>
        <param name="sonar_host" value="$(var sonar_host)"/>
        <param name="sonar_port" value="$(var sonar_port)"/>
        <param name="publish_tf" value="$(var publish_tf)"/>
        <param name="publish_odometry" value="$(var publish_odometry)"/>
        <param name="publish_navsatfix" value="$(var publish_navsatfix)"/>
        <param name="use_sonar_time" value="$(var use_sonar_time)"/>
    </node>
    
    <!-- Point Cloud Filter Node (optional) -->
    <node pkg="pingdsp_driver" exec="pointcloud_filter" name="pointcloud_filter" output="screen" if="$(var enable_filter)">
        <param from="$(var filter_config)"/>
    </node>
    
    <!-- Point Cloud Recorder Node (optional) -->
    <node pkg="pingdsp_driver" exec="pointcloud_recorder" name="pointcloud_recorder" output="screen" if="$(var enable_recorder)">
        <param from="$(var recorder_config)"/>
    </node>
    
    <!-- Sonar Control Node (optional) -->
    <node pkg="pingdsp_driver" exec="sonar_control_node" name="sonar_control_node" output="screen" if="$(var enable_control)">
        <param from="$(var control_config)"/>
        <param name="sonar_host" value="$(var sonar_host)"/>
    </node>
    
    <!-- ROS 2 Bag Recorder (optional) -->
    <executable cmd="ros2 bag record -a" output="screen" if="$(var record_bag)" cwd="$(find-pkg-share pingdsp_driver)/../../../bags"/>
</launch>
