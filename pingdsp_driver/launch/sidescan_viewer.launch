<?xml version="1.0"?>
<!--
  Sidescan viewer: renders a coloured sidescan waterfall from the N most recent
  Ping3DSS messages and publishes it as a sensor_msgs/Image.

  Parameters are loaded from config/sidescan_viewer_params.yaml by default. To
  use another preset at launch time, pass params_file:=/path/to/file; individual
  render knobs remain live tunable with `ros2 param set`.
-->
<launch>
    <arg name="params_file" default="$(find-pkg-share pingdsp_driver)/config/sidescan_viewer_params.yaml"
         description="Path to sidescan viewer parameter YAML file"/>

    <node pkg="pingdsp_driver" exec="sidescan_viewer_node" name="sidescan_viewer_node" output="screen">
        <param from="$(var params_file)"/>
    </node>
</launch>
