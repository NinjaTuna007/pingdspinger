# local/ holds KTH-specific (procurement, quotes, private drive data),
# site-specific RE notes (e.g. local/re/orebro-sonar-head/), backlog design
# docs (local/design/), presentations, and dumps. Never commit it.
local/

# vendor/ IS tracked: it holds vendor technical docs (vendor/docs/) and the
# 3DSS software installers (vendor/software/). Keep large dumps out of here.

# network_dump folder and everything in it
network_dump/

# bags folder and everything in it
bags/

# pointclouds folder and everything in it
pointclouds/

# Sidescan GUI: track the shipped default preset, but keep user presets (and
# any other local config) out of git, and never commit saved images.
gui/sidescan/config/*
!gui/sidescan/config/sidescan_default.json
gui/sidescan/saved/

#pycache stuff in any sub-directory
**/__pycache__/


# vscode / IDE (machine-local paths)
.vscode/
*.code-workspace

# Ultracode / fleet agent runs (scratch pcaps, manifests, ephemeral reports)
.fleet/

# Sidescan export viewer one-time mmap caches (beside *_sidescan.npz on disk)
*_sidescan.log.npy
*_sidescan.meta.npz

# Zip build temp from scripts/pack_sidescan_share.py
*.zip.partial